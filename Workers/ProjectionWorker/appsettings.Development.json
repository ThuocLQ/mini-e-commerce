{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "microshop.order-events",
    "RetryTopic": "microshop.order-events.retry",
    "DeadLetterTopic": "microshop.order-events.dlt",
    "GroupId": "projection-worker",
    "AutoOffsetReset": "Earliest",
    "MaxRetryAttempts": 3,
    "InitialRetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 60,
    "ConsumerErrorDelaySeconds": 3
  },
  "MongoDb": {
    "ConnectionString": "mongodb://microshop:microshop@localhost:27017/?authSource=admin",
    "DatabaseName": "MicroShop_OrderReadDb",
    "OrderSummariesCollectionName": "order_summaries",
    "RebuildModeEnabled": false,
    "RebuildOrderSummariesCollectionName": "order_summaries_rebuild",
    "ProjectionFailuresCollectionName": "projection_failures",
    "ProcessedEventsCollectionName": "processed_projection_events",
    "InitializeMaxRetryCount": 10,
    "InitializeRetryDelaySeconds": 3
  }
}
