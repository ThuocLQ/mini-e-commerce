{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "MicroShop.IdentityService",
    "Audience": "MicroShop.Client",
    "SecretKey": "microshop-development-secret-key-must-be-long-enough"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://microshop:microshop@localhost:27017/?authSource=admin",
    "DatabaseName": "MicroShop_OrderReadDb",
    "OrderSummariesCollectionName": "order_summaries",
    "InitializeMaxRetryCount": 10,
    "InitializeRetryDelaySeconds": 3
  }
}
