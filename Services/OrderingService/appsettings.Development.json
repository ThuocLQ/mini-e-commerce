{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "OrderingDb": "Host=localhost;Port=5432;Database=orderingdb;Username=microshop;Password=microshop"
  },
  "ServiceUrls": {
    "BasketHttp": "https://localhost:7003"
  },
  "Jwt": {
    "Issuer": "MicroShop.IdentityService",
    "Audience": "MicroShop.Client",
    "SecretKey": "microshop-development-secret-key-must-be-long-enough"
  },
  "OrderEvents": {
    "Currency": "USD"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "UserName": "microshop",
    "Password": "microshop"
  },
  "OutboxPublisher": {
    "Enabled": true,
    "BatchSize": 20,
    "IntervalSeconds": 5,
    "MaxRetryCount": 10,
    "LockSeconds": 60,
    "RetryDelaySeconds": 15,
    "MaxRetryDelaySeconds": 300,
    "SimulatePublishFailure": false
  },
  "KafkaOutbox": {
    "BootstrapServers": "localhost:9092",
    "Topic": "microshop.order-events"
  }
}
