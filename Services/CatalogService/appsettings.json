{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogDb": "Host=localhost;Port=5432;Database=catalogdb;Username=microshop;Password=microshop"
  },
  "Jwt": {
    "Issuer": "MicroShop.IdentityService",
    "Audience": "MicroShop.Client",
    "SecretKey": "microshop-development-secret-key-must-be-long-enough"
  },
  "InternalApi": {
    "Key": "SET_BY_ENVIRONMENT"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "UserName": "microshop",
    "Password": "SET_BY_ENVIRONMENT"
  },
  "CatalogOutboxPublisher": {
    "Enabled": true,
    "BatchSize": 20,
    "IntervalSeconds": 5,
    "MaxRetryCount": 10,
    "LockSeconds": 60,
    "RetryDelaySeconds": 15,
    "MaxRetryDelaySeconds": 300
  }

}
